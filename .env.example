# ====================================================================================== #
#                             DATABASE CONFIGURATION                                     #
# ====================================================================================== #
DB_HOST=                # Host do banco de dados (ex: localhost, db.example.com)
DB_PORT=                # Porta do banco de dados (ex: 5432)
DB_USERNAME=            # Usuário do banco de dados
DB_PASSWORD=            # Senha do banco de dados
DB_DATABASE=            # Nome do banco de dados a ser usado

# ====================================================================================== #
#                             JWT / AUTHENTICATION                                       #
# ====================================================================================== #
JWT_SECRET=             # Chave secreta para assinatura do JWT
JWT_EXPIRES_IN=         # Tempo de expiração do token de acesso (ex: 15m, 1h)
JWT_REFRESH_EXPIRES_IN= # Tempo de expiração do token de refresh (ex: 7d, 30d)

# ====================================================================================== #
#                             APPLICATION BASE URL                                       #
# ====================================================================================== #
BASE_URL=               # URL base da aplicação (ex: http://localhost:3000)

# ====================================================================================== #
#                             SMTP / EMAIL CONFIGURATION                                 #
# ====================================================================================== #
SMTP_LOGIN=             # Usuário SMTP (ex: postmaster@seudominio.com)
SMTP_PASSWORD=          # Senha SMTP fornecida pelo provedor
SMTP_HOSTNAME=          # Host SMTP (ex: smtp.mailgun.org)
SMTP_PORT=              # Porta SMTP (ex: 587 para TLS, 465 para SSL)